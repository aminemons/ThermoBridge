* text=auto eol=lf
# Preserve archived run bytes so manifest hashes survive cross-platform checkouts.
/results/** -text whitespace=cr-at-eol
/outputs/** -text whitespace=cr-at-eol
/reports/** -text whitespace=cr-at-eol
/docs/figures/** -text
*.pdf binary
*.png binary
*.npz binary
*.gds binary
*.gz binary
